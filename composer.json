{
    "name": "imnks/sspks-imnks",
    "description": "SSPKS-IMNKS multilingual package repository for Synology DSM 7",
    "license": "GPL-3.0-only",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "ext-phar": "*",
        "mustache/mustache": "^3.2",
        "symfony/yaml": "^7.4",
        "topthink/think-cache": "^3.0",
        "topthink/think-orm": "^4.0",
        "ext-sodium": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "SSpkS\\": "lib/SSpkS/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
