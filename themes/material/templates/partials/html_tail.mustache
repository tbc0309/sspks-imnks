{{/ branch }}
                    </div>
                </footer>
                <button class="back-to-top" type="button" title="{{ back_top }}" aria-label="{{ back_top }}" aria-hidden="true" tabindex="-1" hidden data-back-to-top>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 15.5 12 8l7 7.5"/></svg>
                </button>
        </div>
    </body>
</html>
