{{> html_head }}
<section class="page-hero">
    <span class="eyebrow">DSM 7 PACKAGE SOURCE</span>
    <h1>{{ model_title }}</h1>
    <span class="page-hero__synology-mark" aria-hidden="true"></span>
    <p>{{ model_intro }}</p>
</section>
<div class="model-toolbar" data-model-browser data-show-all="{{ modelShowAllByDefault }}" data-limit-desktop="{{ modelInitialDesktop }}" data-limit-mobile="{{ modelInitialMobile }}">
    <label for="model-search">{{ model_search }}</label>
    <input id="model-search" type="search" placeholder="{{ model_placeholder }}" autocomplete="off" enterkeyhint="search" data-model-search>
    <div class="model-toolbar__status">
        <span data-model-count role="status" aria-live="polite" aria-atomic="true"></span>
        <button class="model-toggle mdl-button" type="button" aria-controls="model-grid" data-model-toggle>{{ show_all }}</button>
    </div>
</div>
{{# advertisementEnabled }}
<aside class="model-ad" aria-label="{{ advertisement }}" data-ad-carousel data-ad-interval="{{ advertisementInterval }}" hidden>
{{# advertisementItems }}
    <a class="ad-banner" href="{{ target_url }}" target="_blank" rel="noopener noreferrer sponsored" aria-label="{{ alt }}" aria-hidden="true" data-ad-slide hidden>
        <img data-src="{{ image_url }}" alt="{{ alt }}" decoding="async" fetchpriority="low">
    </a>
{{/ advertisementItems }}
{{# advertisementHasMultiple }}
    <div class="ad-carousel__dots" role="group" aria-label="{{ advertisement }}">
    {{# advertisementItems }}
        <button type="button" aria-label="{{ advertisement }} {{ position }}" aria-current="false" data-ad-index="{{ index }}"></button>
    {{/ advertisementItems }}
    </div>
{{/ advertisementHasMultiple }}
</aside>
{{/ advertisementEnabled }}
<div class="mdl-grid model-grid" id="model-grid" data-model-grid>
{{# modellist }}
    <a class="mdl-cell mdl-cell--2-col mdl-card small-card clickable-card" href="?arch={{ arch }}" data-model-card data-model-name="{{ name }} {{ arch }}" {{# priority_rank }}data-priority-rank="{{ priority_rank }}"{{/ priority_rank }}>
        <div class="mdl-card__title">
            <h2 class="mdl-card__title-text">{{ name }}</h2>
            <span class="model-arch">{{ arch }}</span>
        </div>
    </a>
{{/ modellist }}
</div>
{{> html_tail }}
